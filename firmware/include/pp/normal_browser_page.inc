 if(resultData&&resultDataKey===key){
  if(!resultTimingPending(resultData)){renderResults(resultData);return}
  resultData=null;resultDataKey=null;resultDataHistorySequence=null;
 }
 let q=selectedHistorySequence?`?sequence=${key}`:'';
 try{
  let r=null;
  for(let attempt=0;attempt<8;attempt++){
   r=await G('/results'+q);
   if(!resultTimingPending(r)||attempt===7)break;
   await new Promise(resolve=>setTimeout(resolve,125));
  }
  if(!r?.sealed){resultData=null;resultDataKey=null;V='home';return home()}
  resultData=r;resultDataKey=key;resultDataHistorySequence=Number(S?.historySequence||0);renderResults(r)
 }catch(e){resultData=null;resultDataKey=null;if(V==='results'){V='home';note(e.status===261?'No completed result is available.':`Results unavailable (HTTP ${e.status||'error'}).`);home()}}
}
